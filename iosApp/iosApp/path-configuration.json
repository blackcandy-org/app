{
  "rules": [
    {
      "patterns": [
        "^/albums/[0-9]+/edit$",
        "^/artists/[0-9]+/edit$",
        "^/playlists/selections/?.+$",
        "^/playlists/new$"
      ],
      "properties": {
        "context": "modal"
      }
    },
    {
      "patterns": [
        "^/albums$"
      ],
      "properties": {
        "view_controller": "albums"
      }
    },
    {
      "patterns": [
        "^/artists$"
      ],
      "properties": {
        "view_controller": "artists"
      }
    }
  ]
}
